# Build outputs — regenerated by scripts/build.sh & scripts/package.sh
dist/

# Runtime data created by docker-compose: generated certs (incl. CA private key),
# logs, and DB state. Regenerable; must never be committed.
takdata/

# Real config & secrets — only *.example / *.example.yaml are committed
.env
overlay/.env
k8s/secret.yaml

# Generated PKI material — never commit certs/keys
*.p12
*.pem
*.jks
*.key
*.csr
certs/files/
