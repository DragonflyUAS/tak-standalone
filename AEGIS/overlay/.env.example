# ───────────────────────────────────────────────────────────────────────────
# AEGIS TAK Server — deployment configuration
#
# Copy to `.env` and fill in the REQUIRED values. `.env` is git-ignored; never
# commit real secrets. All values are read by the TAK container entrypoint
# (docker_entrypoint.sh) and coreConfigEnvHelper.py on first startup, which
# auto-generate the PKI, inject CoreConfig, and initialize the DB schema.
# The image itself is 100% stock (gradle "full" flavor) — all configuration is
# via these env vars; nothing is baked in.
# ───────────────────────────────────────────────────────────────────────────

# ── Database (external PostgreSQL 15 + PostGIS 3) ──────────────────────────
# The DB must be reachable from the TAK container as host `takdb` on port 5432:
# the stock entrypoint initializes the schema against takdb:5432, and POSTGRES_URL
# below points CoreConfig at the same place. Keep them aligned.
#   - docker-compose : the DB service is named `takdb` (see docker-compose.yml).
#   - k8s            : create a Service named `takdb` (ExternalName → managed DB
#                      host, or a headless Service + Endpoints mapping
#                      takdb:5432 → <db-host>:<db-port>).
POSTGRES_DB=cot
POSTGRES_USER=martiuser
POSTGRES_PASSWORD=                                   # REQUIRED — strong password
POSTGRES_URL=jdbc:postgresql://takdb:5432/cot

# ── Certificate Authority / PKI (auto-generated on first start) ────────────
CA_NAME=aegis-tak-ca
CA_PASS=                                             # REQUIRED — CA keystore password

# Certificate subject metadata. REQUIRED: STATE, CITY, ORGANIZATION,
# ORGANIZATIONAL_UNIT (entrypoint refuses to start if any are empty).
# NOTE: the country code is hardcoded to "US" in the stock cert-metadata.sh;
# changing it would require an overlay patch (cosmetic for internal use).
STATE=Taipei
CITY=Taipei
ORGANIZATION=DragonflyUAS
ORGANIZATIONAL_UNIT=AEGIS

# ── Server certificate ─────────────────────────────────────────────────────
TAKSERVER_CERT_PASS=                                 # REQUIRED — takserver keystore password

# ── Admin client certificate (for mTLS web UI login) ───────────────────────
# After first start, retrieve <ADMIN_CERT_NAME>.p12 from the cert volume and
# import it into your browser (password = ADMIN_CERT_PASS) to log into 8443.
ADMIN_CERT_NAME=admin
ADMIN_CERT_PASS=                                     # REQUIRED — admin.p12 password
